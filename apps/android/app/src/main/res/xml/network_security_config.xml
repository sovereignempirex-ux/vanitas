<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is refused everywhere except the Android emulator's view of the
  developer machine, so `npm run dev` on :3000 works while any real deployment
  must present TLS. Production endpoints are https and never hit this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
