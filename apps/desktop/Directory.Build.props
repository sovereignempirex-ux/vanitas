<Project>
  <!-- Shared by every project in apps/desktop so the core and its tests can
       never drift apart on language version, nullability or warning policy. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Deterministic, comparable binaries; also what CI expects. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
