<UserControl x:Class="Vanitas.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock x:Name="Title" Style="{StaticResource Heading}" />

            <!-- Connection -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="ServerLabel" Style="{StaticResource Label}" />
                    <TextBox x:Name="ServerBox" Style="{StaticResource Field}" />
                    <TextBlock x:Name="ServerHint" Style="{StaticResource Hint}"
                               Margin="0,0,0,8" />
                    <Button x:Name="SaveButton" Click="Save_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Alerting -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="AlertsHeading" Style="{StaticResource Label}" />
                    <CheckBox x:Name="NotificationsBox"
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,0,0,10" />
                    <TextBlock x:Name="QuotaLabel" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="QuotaSlider" Width="280" Minimum="1" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,12,0"
                                ValueChanged="Quota_Changed" />
                        <TextBlock x:Name="QuotaValue" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Keyboard -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="KeysHeading" Style="{StaticResource Label}" />
                    <!-- Generated from L10n.Shortcuts, which sits beside the
                         bindings that implement them, so this table cannot go
                         stale while the code changes. -->
                    <ItemsControl x:Name="ShortcutList" />
                </StackPanel>
            </Border>

            <!-- Session -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Button x:Name="SignOutButton" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Click="SignOut_Click" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
