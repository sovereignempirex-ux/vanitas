# Dependencies
node_modules/

# Build output (regenerated by `npm run build`; api/index.js stays tracked
# because vercel.json declares it as a function entry point)
build/
dist/
coverage/

# Secrets — NEVER track these. CI (.github/workflows/ci.yml) fails the build
# if any of them is ever committed again.
.env
.env.*
!.env.example
.env.admin-token

# Local / generated / vendored copies
vanitas (1)/
.vercel

# Logs & OS
*.log
.DS_Store
