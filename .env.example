# AI provider: "ollama" uses an open-source model running on your server.
# "gemini" is optional and may be subject to Google's own quota/pricing.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Optional Gemini key. Leave blank to keep the project free of paid AI providers.
GEMINI_API_KEY=

# Optional free-tier Supabase project. Keep service credentials server-side only.
# Never prefix with VITE_ / NEXT_PUBLIC_ — those leak to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL used by docker-compose / production. Never expose to browser.
# Local: postgresql://vanitas:<strong-password>@localhost:5432/vanitas
# Supabase: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Neon: postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://vanitas:CHANGE_ME_STRONG_PASSWORD@localhost:5432/vanitas

# Admin bootstrap token for initial admin setup (min 32 chars, generate with: openssl rand -base64 32)
# Send as: Authorization: Bearer <token>. Never commit the real value.
ADMIN_API_TOKEN=

# Emails that receive the ADMIN role on register/login (comma-separated).
# On a fresh database the very first registered account also becomes ADMIN.
ADMIN_EMAILS=

# Allowed browser origins (comma-separated). Example: https://vanitas-bot.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional browser-visible API origin for a separately deployed frontend.
VITE_API_BASE_URL=

# Port (Render/Vercel inject PORT automatically)
PORT=3000

# Never enable in production. Local UI testing only.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Social login (OAuth 2.0) — create one app per provider, then paste its keys.
# Leave empty to disable that button on the /login and /register pages.
#
# Callback URLs to register with each provider (use your real domain):
#   Discord: https://<your-domain>/api/v1/social/discord/callback
#   Google:  https://<your-domain>/api/v1/social/google/callback
#   GitHub:  https://<your-domain>/api/v1/social/github/callback
#
# Frontend redirects after callback use FRONTEND_URL (line above),
# e.g. FRONTEND_URL=https://vanitas-bot.vercel.app
# Setup/reference links (the server builds the signed OAuth URLs itself):
# GitHub App installation (not a GitHub OAuth client ID): https://github.com/apps/vanitus200/installations/new/permissions?target_id=280497933&target_type=User
# Google OAuth consent: https://accounts.google.com/o/oauth2/v2/auth?client_id=499139553013-afnm07lv74vitab456kpu0403j5ko4rq.apps.googleusercontent.com&redirect_uri=https://vanitas-bot.vercel.app/api/v1/social/google/callback&response_type=code&scope=openid%20profile%20email&access_type=offline
# Discord OAuth consent: https://discord.com/oauth2/authorize?client_id=1555163822459986010&response_type=code&redirect_uri=https%3A%2F%2Fvanitas-bot.vercel.app%2Fapi%2Fv1%2Fsocial%2Fdiscord%2Fcallback&scope=connections+identify+email+guilds
DISCORD_CLIENT_ID=1555163822459986010
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=499139553013-afnm07lv74vitab456kpu0403j5ko4rq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=Iv23lil3sukjY44D9lsm
GITHUB_CLIENT_SECRET=
