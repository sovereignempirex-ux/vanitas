# AI provider: "ollama" uses a local open-source model; "pollinations" uses
# the free keyless hosted model; "gemini" is optional and may have paid quotas.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Optional Gemini key. Leave blank to keep the project free of paid AI providers.
GEMINI_API_KEY=
# Optional Pollinations token can improve its anonymous rate window; not required.
POLLINATIONS_TOKEN=
# ---------------------------------------------------------------------------
# Python AI microservice (services/ai-service) — the AI/ML domain runs in
# Python per the platform language map. Leave AI_SERVICE_URL empty to keep
# using the built-in TypeScript chain; set it to delegate AI calls to Python
# (automatic fallback to the TS chain whenever the service is unreachable).
AI_SERVICE_URL=
# Shared secret sent as X-Internal-Token when calling the Python service.
AI_SERVICE_TOKEN=
# ---------------------------------------------------------------------------
# Python analytics microservice (services/analytics) — the data-analysis
# domain runs in Python (with an optional R engine) per the platform language
# map. Leave ANALYTICS_SERVICE_URL empty to keep using the built-in
# TypeScript analysis; set it to delegate /api/v1/analytics/* to Python
# (automatic fallback to the TS analysis whenever the service is unreachable).
ANALYTICS_SERVICE_URL=
# Shared secret sent as X-Internal-Token when calling the Python service.
ANALYTICS_SERVICE_TOKEN=
# Per-request budget for one analysis call (default 10000 ms).
ANALYTICS_SERVICE_TIMEOUT_MS=
# ---------------------------------------------------------------------------
# Go rate-limit microservice (services/ratelimit) — the servers/Go domain per
# the platform language map. Leave RATELIMIT_SERVICE_URL empty to keep the
# built-in per-IP limiter; set it and every ceiling is enforced from ONE
# shared bucket (all gateway instances behind a load balancer count the same
# requests). Automatic fallback to the built-in limiter whenever the service
# is unreachable or slower than RATELIMIT_SERVICE_TIMEOUT_MS.
RATELIMIT_SERVICE_URL=
# Shared secret sent as X-Internal-Token when calling the Go service.
# Set the SAME value in the service's environment (it 401s without it).
RATELIMIT_SERVICE_TOKEN=
# Per-request budget for one rate-limit decision (default 300 ms).
RATELIMIT_SERVICE_TIMEOUT_MS=
# ---------------------------------------------------------------------------
# Smart contract (contracts/) — the blockchain domain per the platform
# language map. VanitasCredit is the platform's credit ledger: balances live
# on-chain, and every CREDIT/DEBIT is authorised by an off-chain EIP-712
# signature, so any relayer can submit it and the user pays no gas.
#
# NOTHING in the server reads these. They exist for `forge script` when you
# actually deploy, and for integrations that need to rebuild the EIP-712
# domain separator. `forge test` uses none of them — it runs on Foundry's
# in-process EVM with no RPC, no node and no key, which is what keeps the
# suite runnable offline in CI.
#
# RPC endpoint to broadcast a deployment to (local anvil, a testnet, mainnet).
CREDIT_RPC_URL=http://127.0.0.1:8545
# Deployer account key — REQUIRED to broadcast, ignored by a dry run.
# NEVER commit a real value; the `secrets` CI job rejects tracked keys.
CREDIT_DEPLOYER_PRIVATE_KEY=
# Billing key that signs CREDIT/DEBIT actions off-chain. Leave empty to fall
# back to the deploying account, which is fine on a dev chain and almost
# certainly wrong on mainnet — set it explicitly for any real deployment.
CREDIT_OPERATOR=
# Where the contract was published. An integration needs both this and the
# chain id to compute the EIP-712 domain separator a wallet signs against.
CREDIT_CONTRACT_ADDRESS=

# Optional free-tier Supabase project. Keep service credentials server-side only.
# Never prefix with VITE_ / NEXT_PUBLIC_ — those leak to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL. Never expose this URL to the browser.
# Leave EMPTY (or comment the line out) to run without a database — the app
# falls back to its in-memory store, so `npm run dev` works out of the box.
# Uncomment + run `npm run db:migrate` to get real storage.
# Local: postgresql://vanitas:<strong-password>@localhost:5432/vanitas
# Supabase: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Neon: postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
# Docker: docker-compose derives the container URL (@postgres:5432) from
# POSTGRES_PASSWORD, so this value is ignored inside the container.
# POSTGRES_PASSWORD must match the password inside DATABASE_URL when you set it.
# REQUIRED for Docker: `docker compose up` aborts if this is missing or empty
# (no default password anymore). Generate one with either of:
#   openssl rand -hex 24
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
DATABASE_URL=

# Optional but strongly recommended: independent 32-byte key for encrypting
# invite tokens at rest (generate with: openssl rand -hex 32).
# Falls back to a key derived from DATABASE_URL when empty — which means
# rotating the DB password invalidates every stored invite token.
INVITE_ENC_KEY=

# Admin bootstrap token for initial admin setup (min 32 chars, generate with: openssl rand -base64 32)
# Send as: Authorization: Bearer <token>. Never commit the real value.
ADMIN_API_TOKEN=

# TLS certificate verification for PostgreSQL is ON by default (see src/server/pg.ts).
# Set this ONLY for a self-signed development server you control — it disables
# verification and makes the connection readable by anyone on the network path.
# PG_INSECURE_SSL=true

# Emails that receive the ADMIN role on register/login (comma-separated).
# Configure at least one trusted address before registering the first admin.
ADMIN_EMAILS=

# Local-only convenience for isolated development/test servers. Ignored in production.
ALLOW_FIRST_USER_ADMIN=false

# Allowed browser origins (comma-separated). Example: https://vanitas-bot.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional browser-visible API origin for a separately deployed frontend.
VITE_API_BASE_URL=

# Port (Render/Vercel inject PORT automatically)
PORT=3000

# Never enable in production. Local UI testing only.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Social login (OAuth 2.0) — create one app per provider, then paste its keys.
# Leave empty to disable that button on the /login and /register pages.
#
# Callback URLs to register with each provider (use your real domain):
#   Discord: https://<your-domain>/api/v1/social/discord/callback
#   Google:  https://<your-domain>/api/v1/social/google/callback
#   GitHub:  https://<your-domain>/api/v1/social/github/callback
#
# Frontend redirects after callback use FRONTEND_URL (line above),
# e.g. FRONTEND_URL=https://vanitas-bot.vercel.app
# Setup/reference links (the server builds the signed OAuth URLs itself):
# GitHub App installation (not a GitHub OAuth client ID): https://github.com/apps/vanitus200/installations/new/permissions?target_id=280497933&target_type=User
# Google OAuth consent: https://accounts.google.com/o/oauth2/v2/auth?client_id=499139553013-afnm07lv74vitab456kpu0403j5ko4rq.apps.googleusercontent.com&redirect_uri=https://vanitas-bot.vercel.app/api/v1/social/google/callback&response_type=code&scope=openid%20profile%20email&access_type=offline
# Discord OAuth consent: https://discord.com/oauth2/authorize?client_id=1555163822459986010&response_type=code&redirect_uri=https%3A%2F%2Fvanitas-bot.vercel.app%2Fapi%2Fv1%2Fsocial%2Fdiscord%2Fcallback&scope=connections+identify+email+guilds
#
# NOTE — the GitHub app is requested with scope "read:user user:email public_repo":
# importing a repository only ever READS the user's public repos. The granted
# token is stored server-side only (AES-256-GCM in PostgreSQL mode) and is
# never sent back to any browser.
DISCORD_CLIENT_ID=1555163822459986010
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=499139553013-afnm07lv74vitab456kpu0403j5ko4rq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=Iv23lil3sukjY44D9lsm
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OAuth PROVIDER (Vanitas as the authorization server) needs NO variables:
# third-party apps register themselves in the dashboard (OAuth Apps) and
# their users flow through /oauth/consent → /api/v1/oauth/token.
# Only the consent-ticket key is derived — from DATABASE_URL when set,
# otherwise a per-process key (memory mode).
